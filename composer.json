{
    "name": "poultrypro/poultry-farm",
    "description": "Poultry farm business website and management ERP",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^3.3"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": [ "app/Helpers/helpers.php" ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": false,
        "platform": { "ext-zip": "1.21.0" }
    }
}
