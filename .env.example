APP_NAME=PoultryPro
# local or production. Set APP_DEBUG=false on a live server.
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
# Full address of the site, used in emailed links. Required on a live server.
APP_URL=http://localhost/umar/PoultryPro
CURRENCY=PKR

# log writes emails to storage/logs/mail.log. Use mail on a live server, which needs working PHP mail.
MAIL_DRIVER=log
MAIL_FROM=no-reply@poultrypro.example

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poultrypro
DB_USERNAME=root
DB_PASSWORD=
